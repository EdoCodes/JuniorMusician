---
import Layout from '@/layouts/Layout.astro';
import SchoolCard from '@/components/school/SchoolCard.astro';
import { CITIES, INSTRUMENTS } from '@/data/cities';
import { SCHOOLS, featuredSchools } from '@/data/schools';

const schools = featuredSchools(8);

const stats = [
  { value: String(SCHOOLS.length), label: 'Sample listings' },
  { value: String(CITIES.length),  label: 'U.S. cities' },
  { value: '3',  label: 'Listings per city' },
  { value: '12',   label: 'Instruments & programs' },
];
---

<Layout
  title="Home"
  description="Find music schools for kids nationwide. Search piano, violin, guitar, voice, and more by city on Junior Musician."
>

  <section class="relative overflow-hidden bg-[hsl(var(--navy))]">
    <img
      src="https://images.unsplash.com/photo-1514119412350-e174d90d280e?auto=format&fit=crop&w=1800&q=80"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[50%_40%] opacity-45"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[hsl(213,72%,12%)] via-[hsl(213,72%,12%)/0.88] to-[hsl(213,72%,12%)/0.35]"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/70 mb-4">Nationwide directory</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white leading-[1.1] mb-4">
          Find music schools for kids near you
        </h1>
        <p class="text-base sm:text-lg text-white/80 mb-8 leading-relaxed">
          Search real lesson programs by instrument, city, and rating. Compare listings and reach out with confidence.
        </p>

        <form action="/search" method="get" class="rounded-lg bg-white p-2 shadow-xl">
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="text"
              name="q"
              placeholder="Piano, violin, school name…"
              class="h-12 flex-1 rounded-md border border-border px-4 text-sm outline-none focus:ring-2 focus:ring-primary/20"
            />
            <input
              type="text"
              name="zip"
              placeholder="City or ZIP code"
              maxlength="10"
              class="h-12 sm:w-44 rounded-md border border-border px-4 text-sm outline-none focus:ring-2 focus:ring-primary/20"
            />
            <button
              type="submit"
              class="h-12 rounded-md bg-[hsl(var(--cta))] px-6 text-sm font-semibold text-white hover:bg-[hsl(350,80%,44%)]"
            >
              Search
            </button>
          </div>
        </form>
        <p class="mt-4 text-sm text-white/70">
          Looking for a specific instrument?
          <a href="/instruments" class="font-semibold text-white underline underline-offset-2">Browse programs</a>
        </p>
      </div>
    </div>
  </section>

  <section class="border-b bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
      {stats.map(s => (
        <div class="text-center sm:text-left">
          <div class="text-2xl font-bold text-[hsl(var(--navy))]">{s.value}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-muted-foreground mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-foreground">Our Featured Schools</h2>
      <p class="mt-2 text-muted-foreground">Find local programs parents can count on</p>
    </div>

    {schools.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {schools.map(school => (
          <SchoolCard school={school} />
        ))}
      </div>
    ) : (
      <div class="rounded-lg border bg-slate-50 py-16 text-center">
        <p class="font-semibold text-foreground">No featured listings yet</p>
        <p class="mt-1 text-sm text-muted-foreground">
          <a href="/search" class="text-primary font-medium hover:underline">Browse the full directory</a>
          {' '}or{' '}
          <a href="/register" class="text-primary font-medium hover:underline">list your school</a>.
        </p>
      </div>
    )}

    <div class="mt-10 text-center">
      <a href="/search?featured=true" class="inline-flex h-11 items-center rounded-md border border-border px-5 text-sm font-semibold text-foreground hover:bg-slate-50">
        View all featured listings
      </a>
    </div>
  </section>

  <section class="border-y bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-foreground">Browse by instrument</h2>
        <p class="mt-2 text-muted-foreground">Find lessons that fit your child</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {INSTRUMENTS.map(s => (
          <a
            href={`/instruments/${s.slug}`}
            class="rounded-lg border bg-white px-4 py-4 text-sm font-medium text-foreground hover:border-primary hover:text-primary transition-colors"
          >
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-foreground">How it works</h2>
      <p class="mt-2 text-muted-foreground">Three steps to a music school</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      {[
        { step: '01', title: 'Search by city or instrument', desc: 'Use location and program filters to find piano, violin, guitar, voice, and more.' },
        { step: '02', title: 'Compare listings', desc: 'Review ages served, instruments, ratings, and parent feedback before you reach out.' },
        { step: '03', title: 'Contact the school', desc: 'Call or visit the school’s site to book a trial lesson, then leave a review after you enroll.' },
      ].map(item => (
        <div class="rounded-lg border bg-white p-6">
          <div class="text-xs font-bold uppercase tracking-widest text-primary mb-3">{item.step}</div>
          <h3 class="text-lg font-semibold text-foreground mb-2">{item.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-[hsl(var(--navy))]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="text-3xl font-bold text-white mb-3">Do you run a music school?</h2>
        <p class="text-white/75 text-sm leading-relaxed max-w-md">
          Create a free listing and appear in city and instrument searches. Featured placement is available when you are ready to grow.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href="/register" class="inline-flex h-11 items-center rounded-md bg-[hsl(var(--cta))] px-5 text-sm font-semibold text-white hover:bg-[hsl(350,80%,44%)]">
          List your school
        </a>
        <a href="/advertise" class="inline-flex h-11 items-center rounded-md border border-white/25 px-5 text-sm font-semibold text-white hover:bg-white/10">
          View advertising
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-xl font-bold text-foreground mb-6">Popular cities</h2>
    <div class="flex flex-wrap gap-2">
      {CITIES.slice(0, 24).map(c => (
        <a
          href={`/schools/${c.stateSlug}/${c.citySlug}`}
          class="rounded-md border bg-white px-3 py-2 text-sm text-muted-foreground hover:border-primary hover:text-primary"
        >
          {c.city}, {c.state}
        </a>
      ))}
    </div>
  </section>

</Layout>
