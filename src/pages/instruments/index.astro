---
import Layout from '@/layouts/Layout.astro';
import { INSTRUMENTS } from '@/data/cities';
---

<Layout title="Instruments & programs" description="Browse kids’ music programs by instrument: piano, violin, guitar, voice, drums, Suzuki, and more.">

  <section class="bg-[hsl(var(--navy))] py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-white mb-3">Instruments & programs</h1>
      <p class="text-white/75 leading-relaxed">
        Explore each program type, then browse schools that list it.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {INSTRUMENTS.map(s => (
        <a
          href={`/instruments/${s.slug}`}
          class="group rounded-lg border bg-white p-6 hover:border-primary transition-colors"
        >
          <h2 class="font-semibold text-foreground mb-2 group-hover:text-primary">{s.name}</h2>
          <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">{s.description}</p>
          <div class="mt-4 text-xs font-semibold text-primary">Browse schools</div>
        </a>
      ))}
    </div>
  </div>
</Layout>
