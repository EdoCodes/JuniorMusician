---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Privacy" description="Privacy policy for Junior Musician.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-foreground mb-4">Privacy</h1>
    <p class="text-sm text-muted-foreground leading-relaxed">
      Junior Musician collects only the information you submit through search, listing requests, and contact forms. We do not sell family contact information. This page will be expanded before public launch.
    </p>
  </div>
</Layout>
