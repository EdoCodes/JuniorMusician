---
import Layout from '@/layouts/Layout.astro';
Astro.response.status = 404;
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Error 404</p>
    <h1 class="mt-3 text-3xl font-bold text-foreground">This page is not in the directory</h1>
    <p class="mt-3 text-muted-foreground">
      The address you entered does not match a listing or page on Junior Musician.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-white hover:bg-[hsl(213,72%,18%)]">
        Back to home
      </a>
      <a href="/search" class="inline-flex h-11 items-center justify-center rounded-md border px-5 text-sm font-semibold text-foreground hover:bg-slate-50">
        Browse listings
      </a>
    </div>
  </section>
</Layout>
