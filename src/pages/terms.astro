---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Terms" description="Terms of use for Junior Musician.">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold text-foreground mb-4">Terms</h1>
    <p class="text-sm text-muted-foreground leading-relaxed">
      Listings are informational. Confirm tuition, schedules, and teacher credentials with each school. Junior Musician is not a party to lesson contracts. This page will be expanded before public launch.
    </p>
  </div>
</Layout>
