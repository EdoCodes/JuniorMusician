---
import BrandName from '@/components/layout/BrandName.astro';
import { CITIES, INSTRUMENTS } from '@/data/cities';
const topCities = CITIES.slice(0, 8);
const topInstruments = INSTRUMENTS.slice(0, 6);
---

<footer class="border-t bg-slate-50 mt-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 sm:col-span-3 lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[hsl(var(--navy))] text-white text-xs font-bold">JM</span>
          <BrandName size="footer" />
        </a>
        <p class="mt-3 text-sm text-muted-foreground max-w-xs leading-relaxed">
          A nationwide directory of music schools for kids. Search by city, instrument, and verified reviews.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Directory</h3>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="/search" class="hover:text-foreground">Browse all listings</a></li>
          <li><a href="/search?featured=true" class="hover:text-foreground">Featured schools</a></li>
          {topInstruments.map(s => (
            <li><a href={`/instruments/${s.slug}`} class="hover:text-foreground">{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Top cities</h3>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          {topCities.map(c => (
            <li>
              <a href={`/schools/${c.stateSlug}/${c.citySlug}`} class="hover:text-foreground">
                {c.city}, {c.state}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm text-muted-foreground">
          <li><a href="/about" class="hover:text-foreground">About</a></li>
          <li><a href="/advertise" class="hover:text-foreground">Advertise</a></li>
          <li><a href="/register" class="hover:text-foreground">List your school</a></li>
          <li><a href="/privacy" class="hover:text-foreground">Privacy</a></li>
          <li><a href="/terms" class="hover:text-foreground">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t">
      <p class="text-xs text-muted-foreground mb-3 font-medium">Browse by city</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1.5">
        {CITIES.map(c => (
          <a href={`/schools/${c.stateSlug}/${c.citySlug}`} class="text-xs text-muted-foreground hover:text-foreground">
            Music schools in {c.city}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 border-t pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-muted-foreground">
        © {new Date().getFullYear()} Junior Musician. All rights reserved.
      </p>
      <p class="text-xs text-muted-foreground">
        Listings are provided for informational purposes. Confirm details with each school.
      </p>
    </div>
  </div>
</footer>
