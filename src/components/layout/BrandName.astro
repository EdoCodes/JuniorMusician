---
interface Props {
  size?: 'header' | 'footer';
}
const { size = 'header' } = Astro.props;
const nameClass =
  size === 'header'
    ? 'block text-[18px] sm:text-[20px] font-bold text-[hsl(var(--navy))] tracking-tight'
    : 'text-base font-bold text-[hsl(var(--navy))]';
---

<span class={nameClass} aria-label="Junior Musician">
  Junior Musicia<span class="relative inline-block">n<span class="absolute left-[0.72em] -top-[0.42em] text-[0.42em] font-bold leading-none" aria-hidden="true">®</span></span>
</span>
