---
import type { School } from '@/data/schools';

interface Props {
  school: School;
}

const { school } = Astro.props;
---

<article class="flex h-full flex-col rounded-md border border-border border-l-4 border-l-[hsl(var(--navy))] bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
  <h3 class="text-[15px] font-semibold text-[hsl(var(--navy))] leading-snug">
    <a href={`/schools/${school.slug}`} class="hover:underline">{school.name}</a>
  </h3>
  <p class="mt-1.5 text-xs text-muted-foreground">
    {school.street}, {school.city}, {school.state} {school.zip}
  </p>
  <p class="mt-1 text-xs text-muted-foreground">
    {school.instruments.slice(0, 3).join(' · ')}
  </p>
  <p class="mt-2 text-sm">
    <a href={school.website_url} rel="noopener noreferrer" target="_blank" class="font-medium text-primary hover:underline">
      School website
    </a>
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <a
      href={`/schools/${school.slug}`}
      class="inline-flex h-8 items-center rounded-md bg-primary px-3 text-xs font-semibold text-white hover:bg-[hsl(213,72%,18%)]"
    >
      View listing
    </a>
    <a
      href={school.maps_url}
      rel="noopener noreferrer"
      target="_blank"
      class="inline-flex h-8 items-center rounded-md border border-border px-3 text-xs font-semibold text-foreground hover:bg-slate-50"
    >
      Map
    </a>
  </div>
</article>
